<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{44AD263F-3C1B-4777-8AAF-DDF82B22DD59}</ProjectGuid>
    <RootNamespace>TombRaiderVR</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <!-- Whatever this VS install actually ships. Microsoft.Cpp.Default.props
         sets DefaultPlatformToolset, so this builds on 2019/2022/18 alike
         instead of hard-failing on a toolset that is not installed. -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <PropertyGroup>
    <TargetName>TombRaiderVR</TargetName>
    <OutDir>$(SolutionDir)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)build\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalIncludeDirectories>$(SolutionDir)src;$(SolutionDir)third_party\openvr\headers;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- We patch running code and cast between function pointer types on
           purpose; C4100 fires on the deliberately-unused Submit() parameters. -->
      <DisableSpecificWarnings>4100;4505;4127</DisableSpecificWarnings>
      <!-- Hot-patching our own detours would be self-defeating. -->
      <CreateHotpatchableImage>false</CreateHotpatchableImage>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- openvr_api.dll is resolved with LoadLibrary at runtime, so there is
           deliberately no openvr_api.lib here. -->
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- Static CRT: the DLL is injected into a process we do not control and
           must not depend on a redistributable being present. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\Config.cpp" />
    <ClCompile Include="src\dllmain.cpp" />
    <ClCompile Include="src\Engine.cpp" />
    <ClCompile Include="src\GL.cpp" />
    <ClCompile Include="src\Hooks.cpp" />
    <ClCompile Include="src\InlineHook.cpp" />
    <ClCompile Include="src\Log.cpp" />
    <ClCompile Include="src\StereoRenderer.cpp" />
    <ClCompile Include="src\VideoPanel.cpp" />
    <ClCompile Include="src\VRSystem.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\Config.h" />
    <ClInclude Include="src\Engine.h" />
    <ClInclude Include="src\GL.h" />
    <ClInclude Include="src\Hooks.h" />
    <ClInclude Include="src\InlineHook.h" />
    <ClInclude Include="src\Log.h" />
    <ClInclude Include="src\StereoMath.h" />
    <ClInclude Include="src\StereoRenderer.h" />
    <ClInclude Include="src\VideoPanel.h" />
    <ClInclude Include="src\VRSystem.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TombRaiderVR.ini" />
    <None Include="README.md" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
