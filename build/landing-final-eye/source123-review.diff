 // Follow the visible landing head, with the eye offset in Lara's yaw frame.
 // Pitching the forward eye offset with the impact animation can push the view
 // down into the folded legs. Apply the same fixed scale/pivot as the palette.
+// Stereo adds trackedY AFTER this anchor. During the authored impact crouch,
+// limit extra downward travel to the animated eye height; otherwise a downward
+// glance places the actual view below the head even with a correct anchor.
+// Upward tracking remains live. Tracking/calibration themselves are unchanged.
 inline Point LandingHeadEye(Point head,Point hip,float rootY,float scale,
-                            Point eyeOffset,float yaw) {
+                            Point eyeOffset,float yaw,float trackedY=0) {
     const auto flat=locomotion::Rotate({eyeOffset.x*scale,eyeOffset.z*scale},yaw);
     return {hip.x+(head.x-hip.x)*scale+flat.x,
-            rootY+(head.y-rootY+eyeOffset.y)*scale,
+            rootY+(head.y-rootY+eyeOffset.y)*scale-std::max(0.f,trackedY),
             hip.z+(head.z-hip.z)*scale+flat.z};
 }
 
