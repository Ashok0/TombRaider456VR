+void TraceBodyRenderUpload() {
+    // Temporary capture: five frames/second for the first 90 seconds of FP.
+    // Inspect final uniforms, after body skin and physics uploads. Never bind,
+    // upload, or change a camera/pose while diagnosing the rendered position.
+    if(!Cfg().firstPersonDriftLog || !FirstPersonActive() || !IsWorldPass() ||
+       FirstPersonShadowPass() || MirrorReflectionCapturing() || FirstPersonDrawingTrackedHands()) return;
+    static uint64_t started=0,next=0,serial=0;
+    static bool seen[202][2]{};
+    static unsigned worldCount=0,bodyCount=0;
+    static uint64_t bodyMasks[6]{};static int bodyCounts[6]{};static float bodyKeys[6][24]{};
+    const auto now=GetTickCount64(),frame=VR().PoseSerial();
+    if(!started) started=now;
+    if(now-started>90000) return;
+    if(frame!=serial) {
+        if(now<next) return;
+        serial=frame;next=now+200;worldCount=bodyCount=0;std::memset(seen,0,sizeof(seen));
+    }
+    const auto& state=VidState();
+    if(state.shader<0 || state.shader>=202) return;
+    uint64_t mask=0;int count=0;
+    const float* palette=FirstPersonRenderBodyPalette(mask,count);
+    const bool body=palette && count>=8 && count<=33;
+    if((!body && seen[state.shader][0]) || (body ? bodyCount>=6 : worldCount>=4)) return;
+    float key[24]{};
+    if(body) {
+        std::memcpy(key,palette,12*sizeof(float));std::memcpy(key+12,palette+84,12*sizeof(float));
+        for(unsigned i=0;i<bodyCount;++i)
+            if(bodyMasks[i]==mask && bodyCounts[i]==count && std::memcmp(key,bodyKeys[i],sizeof(key))==0) return;
+    }
+    const auto program=Shaders()[state.shader].id;
+    GLint bound=0;glGetIntegerv(GL_CURRENT_PROGRAM,&bound);
+    renderaudit::Draw draw{};
+    if(!renderaudit::Read(program,body,draw)) return;
+    seen[state.shader][body]=true;
+    if(body) {
+        bodyMasks[bodyCount]=mask;bodyCounts[bodyCount]=count;
+        std::memcpy(bodyKeys[bodyCount],key,sizeof(key));++bodyCount;
+    } else ++worldCount;
+    float nativeRotation[3][3]{},native[3]{};CameraViewFrame(nativeRotation,native);
+    float error=0;
+    if(body) for(int i=0;i<24;++i)
+        error=std::max(error,std::fabs(draw.skin[i]-palette[i<12 ? i : 84+i-12]));
+    const auto& v=draw.view;const auto& p=draw.projection;const auto& j=draw.skin;
+    LogF("render-audit: pose=%llu shader=%d program=%u bound=%d body=%d count=%d mask=%llx palette-error=%.6f native=(%.3f,%.3f,%.3f) view=(%.6f,%.6f,%.6f,%.3f;%.6f,%.6f,%.6f,%.3f;%.6f,%.6f,%.6f,%.3f) proj=(%.6f,%.6f,%.6f,%.6f;%.6f,%.6f,%.6f,%.6f;%.6f,%.6f,%.6f,%.6f;%.6f,%.6f,%.6f,%.6f) skin0=(%.6f,%.6f,%.6f,%.3f;%.6f,%.6f,%.6f,%.3f;%.6f,%.6f,%.6f,%.3f) skin7=(%.6f,%.6f,%.6f,%.3f;%.6f,%.6f,%.6f,%.3f;%.6f,%.6f,%.6f,%.3f)",
+        frame,state.shader,program,bound,body,count,static_cast<unsigned long long>(mask),error,native[0],native[1],native[2],
+        v[0],v[1],v[2],v[3],v[4],v[5],v[6],v[7],v[8],v[9],v[10],v[11],
+        p[0],p[1],p[2],p[3],p[4],p[5],p[6],p[7],p[8],p[9],p[10],p[11],p[12],p[13],p[14],p[15],
+        j[0],j[1],j[2],j[3],j[4],j[5],j[6],j[7],j[8],j[9],j[10],j[11],
+        j[12],j[13],j[14],j[15],j[16],j[17],j[18],j[19],j[20],j[21],j[22],j[23]);
+}
