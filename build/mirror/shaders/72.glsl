#version 150 
uniform sampler3D sNoise;
	uniform mat4 uProjMatrix;
	uniform vec4 uViewMatrix[4];
	uniform mat4 uShadowMatrix[6];
	uniform vec4 uShadowFalloff[6];
	uniform vec4 uShadowPos[6];
	uniform vec4 uFogColor;
    uniform vec4 uFogPlane;
    uniform vec4 uDofPlane;
    uniform vec4 uEffectOffsets[3];
    uniform vec4 uModelMatrix[4];
    uniform vec4 uParams;
    uniform vec4 uColor;
    uniform vec4 uLightPos[8];
    uniform vec4 uLightCol[8];
    uniform vec4 uLightDir[8];
    uniform vec4 uAmbient[6];
    uniform vec4 uJoints[72 * 3];
    out vec2 vTexCoord;
    out vec3 vColor;
    out vec3 vLight;
    out float vLayer;
    out float vFog;
    out vec3 vNormal;
    out vec3 vPos;
    in vec4 aCoord; 
    in vec4 aNormal;   
    in vec4 aLight;   
    in vec4 aColor;   
void main() {
    vec4 coord = vec4(aCoord);
    vec4 normal = vec4(aNormal);
    vec4 light = aLight;
    vec4 color = aColor;
    vec2 uv = vec2(light.w, color.w);
    vTexCoord = uv;
    normal.xyz = normalize(normal.xyz - 127.0);
    vNormal = normal.xyz;
    vLight = pow(light.xyz, vec3(2.2, 2.2, 2.2));
    vColor = pow(color.xyz, vec3(2.2, 2.2, 2.2));
    vLayer = normal.w;
    vec4 p = vec4(dot(uModelMatrix[0], vec4(coord.xyz, 1.0)), dot(uModelMatrix[1], vec4(coord.xyz, 1.0)), dot(uModelMatrix[2], vec4(coord.xyz, 1.0)), 1.0);
    vec3 wp = p.xyz + vec3(uViewMatrix[0].w, uViewMatrix[1].w, uViewMatrix[2].w);
    float weight = coord.w / 1024.0;
    float k = texture(sNoise, wp / (32.0 * 1024.0)).x;
    float t = uModelMatrix[3].x;
    p.y += sin(k * (3.1415926536 * 2.0) + t) * weight;
    vFog = clamp(exp(-((length(p.xyz) / ((30.0 * 1000.0) / 2))*(length(p.xyz) / ((30.0 * 1000.0) / 2)))), 0.0, 1.0);
    vPos = p.xyz;
    gl_Position = ((uProjMatrix) * (vec4(dot(uViewMatrix[0].xyz, (p).xyz), dot(uViewMatrix[1].xyz, (p).xyz), dot(uViewMatrix[2].xyz, (p).xyz), (p).w)));
}
