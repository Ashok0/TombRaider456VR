+        g_pistolArmPose.item==item && g_pistolArmPose.game==g_boundDll->game &&
+        g_pistolArmPose.pass==pass && g_pistolArmPose.serial==VR().PoseSerial() &&
+        g_pistolArmPose.fraction==*Ptr<int32_t>(g_boundDll->frameFrac);
+}
