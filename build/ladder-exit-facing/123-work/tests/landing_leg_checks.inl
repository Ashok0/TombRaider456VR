// Native animation fixtures are regenerated by tools/extract_landing_poses.py.
#include "native_landing_poses.inl"
void CheckLandingLegPalette(const tr::motiongun::Frame (&native)[15],const tr::motiongun::Frame (&shown)[15],float size) {
    using namespace tr::motiongun;
    const tr::motiongun::Vec shift=Sub(shown[0].origin,Scale(native[0].origin,size));
    Check(std::fabs(shift.y)<.06f,"landing scaling uses the floor reference, never the falling animated eye");
    for(int j=0;j<7;++j) {
        Check(tr::firstperson::Length(Sub(shown[j].origin,Add(Scale(native[j].origin,size),shift)))<.06f,
            "landing preserves the scaled native pelvis, knee and ankle positions");
        for(int r=0;r<3;++r) for(int c=0;c<3;++c)
            Check(std::fabs(shown[j].basis.r[r][c]-native[j].basis.r[r][c]*size)<.0001f,
                "landing leg meshes retain native rotations and rigid calibrated size");
    }
}
